{
    "name": "yezzmedia/laravel-user-content",
    "description": "Customer-managed pages, navigation, redirects, and forms for Yezz Media customer projects.",
    "type": "library",
    "license": "MIT",
    "version": "0.1.2",
    "require": {
        "php": "^8.3",
        "yezzmedia/laravel-foundation": "^0.2",
        "yezzmedia/laravel-user-projects": "^0.2",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-sluggable": "^3.8",
        "spatie/laravel-honeypot": "^4.7",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "livewire/livewire": "^4.0",
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.9",
        "spatie/laravel-activitylog": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "YezzMedia\\Content\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YezzMedia\\Content\\ContentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
